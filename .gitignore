# OS noise
.DS_Store
**/.DS_Store
Thumbs.db

# Logs and runtime state
logs/
*.log
*.pid
*.tmp

# Local env / secrets
.env
.env.*
!.env.example

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/

# Node / JS dependencies and caches
node_modules/
.npm/
.pnpm-store/
.yarn/
.turbo/

# Agent/editor local state
.claude/settings.local.json
.claude/worktrees/
.firecrawl/

# Local scratch memory, not canonical repo knowledge
.local-memory/

# Local media archive, not canonical repo source
.local-archive/

# Local writing scratch, keep only placeholders in origin
content/inbox/**
!content/inbox/.gitkeep

content/drafts/**
!content/drafts/.gitkeep

# Media and design binaries are kept in .local-archive/ or external storage, not git
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.avif
*.heic
*.tif
*.tiff
*.psd
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.avi
*.mp3
*.wav
*.m4a
*.flac
*.ai
*.sketch
*.fig

# Documentation images are part of docs and may be tracked.
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.webp
!docs/**/*.gif
!docs/**/*.avif

# Superpowers / visual companion generated scratch files
.superpowers/

# Skill execution intermediate working files
.skill-work/

# Local skill install/export scratch
.baoyu-skills/
.agents/skills/*.zip
skills-lock.json

# WeChat/browser runtime state
**/chrome-profile/
**/Chrome Profile/
**/user-data-dir/
**/Cookies
**/Cookies-journal

# PoC screenshots may capture WeChat backend / login state — never commit
scripts/.poc-artifacts/
.agents/skills/wechat-article-publisher/scripts/.artifacts/

# Generated outputs and temporary working files
output/
tmp/
.backups/
.agents/skills/seedance-video-workspace/
volcengine-web-search-workspace/
volcengine-doc-fetcher-workspace/
tts-output/

# Skill eval iteration outputs are local-only (large, regenerable)
.agents/skills/*/evals/iteration-*/

# Article-to-notion skill: Python cache
.agents/skills/article-to-notion/scripts/__pycache__/
