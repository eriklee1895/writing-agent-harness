# 各 API key 的详细申请步骤、开通服务、权限配置见对应 skill 的 SKILL.md 前置条件段。
# 未用到的 skill 对应的 key 留空即可，不会影响其他功能。

# ── OpenAI 兼容图像生成（gpt-image-2 / article-illustration 用） ──
# 申请：https://platform.openai.com/api-keys （或你所用网关/代理的 key 管理页）
OPENAI_API_KEY=
OPENAI_BASE_URL=                    # 可选；走代理/网关时填，默认直连 OpenAI

# ── 火山方舟模型平台（seedream-image-gen / seedance-video-gen 用） ──
# 申请：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
ARK_API_KEY=

# ── 火山豆包语音 TTS（volcengine-tts 用） ──
# 申请步骤见 .agents/skills/volcengine-tts/SKILL.md
VOLC_SPEECH_API_KEY=

# ── 火山引擎"搜索无限"API（volcengine-web-search 用） ──
# 申请：https://console.volcengine.com/search-infinity/api-key
VOLC_WEB_SEARCH_API_KEY=

# ── 火山引擎 AK/SK（仅 volcengine-bigmusic-bgm BGM 生成用；其他火山服务用上面的 bearer key，不用这对） ──
# 申请步骤见 .agents/skills/volcengine-bigmusic-bgm/SKILL.md（需在控制台开通"AI 生成音乐大模型"并勾选按时长计费）
VOLC_ACCESSKEY=
VOLC_SECRETKEY=

# ── Notion（可选：默认无需 key，运行 `ntn login` 走 OAuth 即可） ──
# 安装 ntn CLI：https://ntn.dev  → 运行 `ntn login` 浏览器授权一次，凭证存系统 keychain
# NOTION_API_TOKEN=                # 仅 CI/headless 场景下作为 OAuth 替代（注意名字是 NOTION_API_TOKEN，不是 NOTION_TOKEN）
